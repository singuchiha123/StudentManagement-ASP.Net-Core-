@model StudentManagement.Models.Course

<h1>Delete Course</h1>

<div class="alert alert-danger">
    <h5>Are you sure you want to delete this course?</h5>
</div>

<div class="mb-3">
    <strong>Code:</strong>
    @Model.Code
</div>

<div class="mb-3">
    <strong>Name:</strong>
    @Model.Name
</div>

<div class="mb-3">
    <strong>Students:</strong>
    @Model.Students.Count
</div>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>